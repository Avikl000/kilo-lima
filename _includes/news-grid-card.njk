{#- News grid card. Expects `post`. -#}
<li class="n-card">
  <a href="{{ post.url }}">
    {% if post.data.cover %}<img src="{{ post.data.cover }}" alt="" loading="lazy">{% endif %}
    <div class="nc-body">
      {% if post.data.category %}<span class="cat-tag">{{ post.data.category }}</span>{% endif %}
      <h3 class="nc-title">{{ post.data.title }}</h3>
      <p class="nc-meta">{{ post.date | readableDate }}</p>
    </div>
  </a>
</li>
