<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · Kilo-Lima</title>
  <meta name="theme-color" content="#314E67">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="wordmark" href="/">Kilo-Lima</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a>
        <a href="/news/"{% if page.url | startsWith('/news') %} aria-current="page"{% endif %}>News</a>
        <a href="/itineraries/"{% if page.url | startsWith('/itineraries') %} aria-current="page"{% endif %}>Itineraries</a>
      </nav>
    </div>
  </header>
  <main class="{{ mainClass or 'wrap' }}">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <span>Kilo-Lima</span>
      <span class="tagline">built to operate</span>
    </div>
  </footer>
</body>
</html>
