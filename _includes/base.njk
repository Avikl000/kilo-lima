<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · Kilo Lima</title>
  <style>
    body { max-width: 42rem; margin: 2rem auto; padding: 0 1rem; font-family: system-ui, sans-serif; line-height: 1.6; color: #1a1a1a; }
    a { color: #0a5ad4; }
    header { margin-bottom: 2rem; border-bottom: 1px solid #ddd; padding-bottom: 1rem; }
    header a { text-decoration: none; color: inherit; font-weight: 700; }
    .post-list li { margin-bottom: 0.5rem; }
    time { color: #666; font-size: 0.9em; }
    img { max-width: 100%; }
  </style>
</head>
<body>
  <header><a href="/">Kilo Lima</a></header>
  <main>
    {{ content | safe }}
  </main>
</body>
</html>
