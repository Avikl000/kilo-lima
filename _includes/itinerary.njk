---
layout: base.njk
---
<article class="itinerary">

  {% include "itinerary/hero.njk" %}
  {% include "itinerary/section-nav.njk" %}

  <section id="overview" class="itin-section" aria-labelledby="overview-heading">
    <div class="wrap-wide">
      <h2 id="overview-heading">Overview</h2>
      <div class="overview-grid">
        <div class="overview-copy">
          {{ content | safe }}
          {% if highlights and highlights.length %}
          <ul class="at-a-glance">
            {%- for h in highlights %}
            <li>{{ h }}</li>
            {%- endfor %}
          </ul>
          {% endif %}
        </div>
        {% include "itinerary/key-facts.njk" %}
      </div>
    </div>
  </section>

  {% if experiences and experiences.length %}
  <section id="highlights" class="itin-section" aria-labelledby="highlights-heading">
    <div class="wrap-wide">
      <h2 id="highlights-heading">Highlights</h2>
      <div class="highlight-list">
        {%- for e in experiences %}
        {% set exp = e %}
        {% set expIndex = loop.index %}
        {% include "itinerary/highlight.njk" %}
        {%- endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if residences and residences.length %}
  <section id="residences" class="itin-section" aria-labelledby="residences-heading">
    <div class="wrap-wide">
      <h2 id="residences-heading">Residences</h2>
      <ul class="residence-grid">
        {%- for r in residences %}
        {% set res = r %}
        {% include "itinerary/residence-card.njk" %}
        {%- endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% if routeMap %}
  <section id="route" class="itin-section" aria-labelledby="route-heading">
    <div class="wrap-wide">
      <h2 id="route-heading">Route</h2>
      <figure class="route-map">
        <img src="{{ routeMap }}" alt="Route map for {{ title }}" loading="lazy">
        {% if routeMapCredit %}<figcaption>{{ routeMapCredit }}</figcaption>{% endif %}
      </figure>
    </div>
  </section>
  {% endif %}

  {% if days and days.length %}
  <section id="itinerary" class="itin-section" aria-labelledby="itinerary-heading">
    <div class="wrap-wide">
      <div class="section-head">
        <h2 id="itinerary-heading">Itinerary</h2>
        {% if pdfUrl %}
        <a class="pdf-link" href="{{ pdfUrl }}">Save PDF</a>
        {% endif %}
      </div>

      <ol class="day-list">
        {%- for d in days %}
        {% set day = d %}
        {% set dayIndex = loop.index %}
        {% include "itinerary/day.njk" %}
        {%- endfor %}
      </ol>
    </div>
  </section>
  {% endif %}

  {% if inclusions and inclusions.length %}
  <section id="inclusions" class="itin-section" aria-labelledby="inclusions-heading">
    <div class="wrap-wide">
      <h2 id="inclusions-heading">Inclusions</h2>
      <ul class="inclusion-list">
        {%- for i in inclusions %}
        <li>{{ i }}</li>
        {%- endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {% if testimonials and testimonials.length %}
  <section id="reviews" class="itin-section" aria-labelledby="reviews-heading">
    <div class="wrap-wide">
      <h2 id="reviews-heading">What guests say</h2>
      <div class="testimonial-grid">
        {%- for t in testimonials %}
        {% set quote = t %}
        {% include "itinerary/testimonial.njk" %}
        {%- endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <div class="wrap-wide">
    {% set ctaDefaultLabel = "Enquire now" %}
    {% include "cta.njk" %}
  </div>

  {% set related = collections.itineraries | sortByStartDate | excludeUrl(page.url) | limit(3) %}
  <section id="keep-exploring" class="itin-section" aria-labelledby="keep-exploring-heading">
    <div class="wrap-wide">
      <h2 id="keep-exploring-heading">Keep exploring</h2>
      {% if related.length %}
      <ul class="related-grid">
        {%- for t in related %}
        {% set trip = t %}
        {% include "itinerary/related-card.njk" %}
        {%- endfor %}
      </ul>
      {% else %}
      <p class="muted">More journeys are on the way.</p>
      {% endif %}
      <a class="back-link" href="/itineraries/">&larr; All itineraries</a>
    </div>
  </section>

</article>

<script>
  /* Progressive enhancement: mark the section the reader is in. */
  (function () {
    var nav = document.querySelector('.section-nav');
    if (!nav || !('IntersectionObserver' in window)) return;
    var links = Array.prototype.slice.call(nav.querySelectorAll('a'));
    var byId = {};
    links.forEach(function (a) { byId[a.getAttribute('href').slice(1)] = a; });
    var sections = links
      .map(function (a) { return document.getElementById(a.getAttribute('href').slice(1)); })
      .filter(Boolean);

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        links.forEach(function (a) { a.removeAttribute('aria-current'); });
        var active = byId[entry.target.id];
        if (active) active.setAttribute('aria-current', 'true');
      });
    }, { rootMargin: '-45% 0px -50% 0px' });

    sections.forEach(function (s) { observer.observe(s); });

    /* Short final sections never reach the observer's middle band, so
       highlight the last link explicitly at the bottom of the page. */
    window.addEventListener('scroll', function () {
      if (window.innerHeight + window.scrollY < document.documentElement.scrollHeight - 4) return;
      links.forEach(function (a) { a.removeAttribute('aria-current'); });
      links[links.length - 1].setAttribute('aria-current', 'true');
    }, { passive: true });
  })();
</script>
