---
layout: base.njk
title: Home
---
<section class="hero">
  <p class="eyebrow">The versatile operator</p>
  <h1><span class="gradient-text">Kilo-Lima</span></h1>
  <p class="lede">This test site is managed with <a href="https://pagescms.org">Pages CMS</a>.</p>
</section>

{%- if collections.itineraries.length %}
<section class="home-section">
  <div class="section-head">
    <h2>Journeys</h2>
    <a class="more-link" href="/itineraries/">View all journeys &rarr;</a>
  </div>
  <ul class="post-list">
    {%- for trip in collections.itineraries | sortByStartDate | limit(3) %}
    {% include "card-journey.njk" %}
    {%- endfor %}
  </ul>
</section>
{%- endif %}

{%- if collections.posts.length %}
<section class="home-section">
  <div class="section-head">
    <h2>News</h2>
    <a class="more-link" href="/news/">View all news &rarr;</a>
  </div>
  <ul class="post-list">
    {%- for post in collections.posts | reverse | limit(3) %}
    {% include "card-post.njk" %}
    {%- endfor %}
  </ul>
</section>
{%- endif %}
