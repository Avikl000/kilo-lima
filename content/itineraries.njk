---
layout: base.njk
title: Itineraries
permalink: /itineraries/
mainClass: wrap-wide
---
<header class="page-head">
  <p class="eyebrow">Journeys</p>
  <h1>Itineraries</h1>
  <p class="lede">Private-charter journeys by King Air, built around each brief.</p>
</header>

{%- set journeys = collections.itineraries | sortByStartDate %}
{%- if journeys.length %}
{%- set featured = journeys[0] %}
{% set trip = featured %}{% include "itin-featured.njk" %}
{%- set rest = journeys | excludeUrl(featured.url) %}
{%- if rest.length %}
<ul class="journey-grid">
  {%- for trip in rest %}
  {% include "itin-grid-card.njk" %}
  {%- endfor %}
</ul>
{%- endif %}
{%- endif %}
